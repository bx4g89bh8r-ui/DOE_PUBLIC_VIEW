{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doe/public-sanitized-snapshot-v1.schema.json",
  "title": "DOE public allowlisted snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meta", "general", "portfolio_snapshot", "candidates", "events", "alert_rules", "notification_adapter"],
  "properties": {
    "schema": {"const": "DOE_SAFARI_PUBLIC_SNAPSHOT_v1"},
    "meta": {
      "type": "object",
      "required": ["generated_at", "data_as_of", "next_review_expected", "update_status", "engine_version", "broker_connectivity", "sanitizer_version"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "data_as_of": {"type": ["string", "null"]},
        "next_review_expected": {"type": "string", "format": "date-time"},
        "update_status": {"enum": ["CURRENT", "DELAYED", "STALE", "UNAVAILABLE"]},
        "engine_version": {"const": "B2-PATCH-v0.2.17"},
        "broker_connectivity": {"const": "NONE"},
        "sanitizer_version": {"const": "DOE_PUBLIC_SANITIZER_v1"}
      }
    },
    "portfolio_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_label", "access", "visibility", "economic_as_of", "economic_age_hours", "economic_authority"],
      "properties": {
        "authority_label": {"const": "SNAPSHOT"},
        "access": {"const": "READ_ONLY"},
        "visibility": {"const": "PUBLIC_ANONYMIZED"},
        "economic_as_of": {"type": "string"},
        "economic_age_hours": {"type": "number"},
        "economic_authority": {"const": "SQLITE_OUTSIDE_PUBLIC_VIEW"}
      }
    },
    "general": {"type": "object"},
    "candidates": {"type": "array"},
    "events": {"type": "array"},
    "alert_rules": {"type": "object"},
    "notification_adapter": {"type": "object"}
  }
}
